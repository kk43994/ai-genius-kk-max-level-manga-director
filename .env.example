# Documentation only; the application does not automatically load this file.
# Customer data belongs outside release code; production path is owned by session 9.
ASSET_LAB_DATA_DIR=/var/lib/asset-lab
ASSET_LAB_SECRET_KEY_FILE=/etc/asset-lab/storage.key
ASSET_LAB_PUBLIC_ORIGIN=https://replace-with-confirmed-domain.example
ASSET_LAB_HOST=127.0.0.1
ASSET_LAB_PORT=8890
ASSET_LAB_PUBLIC_BASE_PATH=/asset-lab/
# Omit API_BASE to derive /asset-lab/api/v1 from PUBLIC_BASE_PATH.
# ASSET_LAB_API_BASE=/asset-lab/api/v1
# Both are required together for immutable packaged releases.
# ASSET_LAB_RELEASE_ROOT=/opt/asset-lab-customer
# ASSET_LAB_RUNNING_MANIFEST=/opt/asset-lab-customer/releases/RELEASE_ID/release.json
ASSET_LAB_ALLOW_PAID_SUBMISSION=false
ASSET_LAB_VIDEO_GENERATION=false
